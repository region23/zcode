# zcode Environment Configuration Example
# Copy this file to .env and fill in your API keys
# Then run: source .env

# ============================================
# API Keys (at least one required)
# ============================================

# OpenAI (https://platform.openai.com/api-keys)
export OPENAI_API_KEY="sk-..."

# Anthropic Claude (https://console.anthropic.com/settings/keys)
export ANTHROPIC_API_KEY="sk-ant-..."

# Z.AI (https://z.ai)
export ZAI_API_KEY="..."

# DeepSeek (https://platform.deepseek.com/api_keys)
# OR use OpenRouter key below for DeepSeek access
export DEEPSEEK_API_KEY="..."

# Qwen (https://dashscope.aliyuncs.com/)
# OR use OpenRouter key below for Qwen access
export QWEN_API_KEY="..."

# OpenRouter (https://openrouter.ai/keys)
# Provides access to multiple models including DeepSeek, Qwen, and others
export OPENROUTER_API_KEY="sk-or-..."

# ============================================
# Default Settings (optional)
# ============================================

# Default provider to use on startup
# Options: openai, anthropic, zai, deepseek, qwen, openrouter
# Default: openai (if OPENAI_API_KEY is set)
export ZCODE_DEFAULT_PROVIDER="anthropic"

# Default mode to start in
# Options: plan, build
# Default: build
export ZCODE_DEFAULT_MODE="build"

# ============================================
# Available Models by Provider
# ============================================

# OpenAI Models:
# - gpt-4o (default, recommended)
# - gpt-4o-mini (faster, cheaper)
# - o1 (reasoning model)
# - o1-mini (smaller reasoning model)

# Anthropic Models:
# - claude-sonnet-4-5-20250929 (default, recommended)
# - claude-opus-4-5-20251101 (most capable)
# - claude-haiku-4-20250415 (fastest, cheapest)

# Z.AI Models:
# - glm-4.7 (default)

# DeepSeek Models:
# - deepseek-chat (default)
# - deepseek-coder (coding-focused)

# Qwen Models:
# - qwen-max (default)
# - qwen-plus (faster)

# OpenRouter Models:
# - openai/gpt-4o (default)
# - Any model available on OpenRouter

# ============================================
# Usage
# ============================================

# 1. Copy this file:
#    cp .env.example .env
#
# 2. Fill in at least one API key above
#
# 3. Load environment:
#    source .env
#
# 4. Run zcode:
#    zig build run
#
# 5. Switch providers/models:
#    Press Ctrl+P in the application

# ============================================
# Security Notes
# ============================================

# - Never commit .env with real API keys to version control
# - .env is in .gitignore by default
# - Keep your API keys secret
# - Rotate keys if exposed
# - Use separate keys for development and production
