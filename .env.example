# zcode Configuration Example
# Copy this file to .env and fill in your API keys

# Required: At least one API key
OPENAI_API_KEY=sk-...
ANTHROPIC_API_KEY=sk-ant-...
ZAI_API_KEY=...
DEEPSEEK_API_KEY=...
QWEN_API_KEY=...
OPENROUTER_API_KEY=sk-or-...

# Optional: Override defaults
ZCODE_DEFAULT_PROVIDER=openai  # openai, anthropic, zai, deepseek, qwen, openrouter
ZCODE_DEFAULT_MODE=build       # plan or build
